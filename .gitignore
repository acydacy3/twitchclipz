# ── Rohe Download-Ordner (original Quellmaterial, riesig, nicht reproduzierbar) ──
okene_dl/
lengede_dl/
koepcke_dl/
*_dl/

# ── Gerenderte Endprodukte (reproduzierbar via nb_build.py / lang.py) ──
*/render/*.mp4
*/render/*.webm

# ── Manim-Zwischenschritte (werden bei jedem Lauf neu erzeugt) ──
media/

# ── Vendored Video-Engines: Abhängigkeiten NIE committen (per-Container installiert) ──
# Code + Rezepte + Templates liegen im Repo; deps holt tools/nb_install_video_engines.sh
node_modules/
.venv/
tools/vendor/**/node_modules/
tools/vendor/**/.venv/
.claude/skills/**/node_modules/
.claude/skills/**/.venv/
# Render-/Session-Ausgaben der Engines (reproduzierbar)
**/out/
**/render.mp4
**/render.webm
edit/
.env

# ── Python / Tool-Cache ──
__pycache__/
*.log
tools/piper/
tools/setup-tools.log
tools/tools-status.txt
tools/demo_*.mp4
tools/demo_vo.mp3
tools/manim_render.log

# ── Alte Einzel-Ausnahmen (nuttyputty hat eigene .gitignore) ──
nuttyputty/animation/capture_clean.py
nuttyputty/animation/querschnitt_clean.*
nuttyputty/animation/clean_*.png
nuttyputty/_s08_small.mp4
nuttyputty/animation/frames_clean/
nuttyputty/upload_results.json
*/animation/_words_vosk_backup/
