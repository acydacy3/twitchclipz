Dialogue: 0,0:00:00.00,0:00:00.98,Default,,0,0,0,,5 Tage lang hatte
Dialogue: 0,0:00:00.98,0:00:02.50,Default,,0,0,0,,Rallsturm versucht, durch den
Dialogue: 0,0:00:02.50,0:00:03.94,Default,,0,0,0,,Knochen zu schneiden. Das
Dialogue: 0,0:00:03.94,0:00:05.12,Default,,0,0,0,,Messer war zu stumpf,
Dialogue: 0,0:00:05.34,0:00:06.32,Default,,0,0,0,,erschafft es nicht mal,
Dialogue: 0,0:00:06.62,0:00:07.92,Default,,0,0,0,,die Haut richtig aufzuritzen.
Dialogue: 0,0:00:08.38,0:00:09.64,Default,,0,0,0,,Dann, am 6. Morgen,
Dialogue: 0,0:00:10.00,0:00:10.90,Default,,0,0,0,,in einem Moment Bura
Dialogue: 0,0:00:10.90,0:00:12.08,Default,,0,0,0,,Wut, presst er seinen
Dialogue: 0,0:00:12.08,0:00:13.12,Default,,0,0,0,,Arm gegen den Felsen
Dialogue: 0,0:00:13.12,0:00:14.86,Default,,0,0,0,,und spürte etwas. Die
Dialogue: 0,0:00:14.86,0:00:16.32,Default,,0,0,0,,Knochen buggen sich. Er
Dialogue: 0,0:00:16.32,0:00:17.82,Default,,0,0,0,,presse weiter, bog den
Dialogue: 0,0:00:17.82,0:00:19.28,Default,,0,0,0,,Arm weiter und dann
Dialogue: 0,0:00:19.28,0:00:20.74,Default,,0,0,0,,knack, der erste unter
Dialogue: 0,0:00:20.74,0:00:22.04,Default,,0,0,0,,Arm Knochen brach, er
Dialogue: 0,0:00:22.04,0:00:24.12,Default,,0,0,0,,bog weiter. Knack, der
Dialogue: 0,0:00:24.12,0:00:26.20,Default,,0,0,0,,zweite. Rallsturm beschreibt diesen
Dialogue: 0,0:00:26.20,0:00:27.88,Default,,0,0,0,,Moment als Euphorie, als
Dialogue: 0,0:00:27.88,0:00:29.34,Default,,0,0,0,,die intensivste Freude seines
Dialogue: 0,0:00:29.34,0:00:30.86,Default,,0,0,0,,Lebens. Er krifft zum
Dialogue: 0,0:00:30.86,0:00:32.52,Default,,0,0,0,,Messer, schnitt durch Szene,
Dialogue: 0,0:00:33.14,0:00:35.44,Default,,0,0,0,,durch Muskel, durch Blutgefäße,
Dialogue: 0,0:00:35.86,0:00:36.66,Default,,0,0,0,,dann kam er an
Dialogue: 0,0:00:36.66,0:00:38.02,Default,,0,0,0,,den Nerf, er beschreibt
Dialogue: 0,0:00:38.02,0:00:39.00,Default,,0,0,0,,es als tausend Mal
Dialogue: 0,0:00:39.00,0:00:40.36,Default,,0,0,0,,schlimmer als alles, was
Dialogue: 0,0:00:40.36,0:00:41.26,Default,,0,0,0,,er je gespürt hatte.
Dialogue: 0,0:00:41.72,0:00:42.62,Default,,0,0,0,,Aber er schnitt weiter,
Dialogue: 0,0:00:43.02,0:00:44.90,Default,,0,0,0,,65 Minuten, bis der
Dialogue: 0,0:00:44.90,0:00:46.04,Default,,0,0,0,,Arm ab war, dann
Dialogue: 0,0:00:46.04,0:00:47.76,Default,,0,0,0,,fiel er rückwärts, frei.