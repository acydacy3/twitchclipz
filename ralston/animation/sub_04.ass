Dialogue: 0,0:00:00.00,0:00:01.48,Default,,0,0,0,,Ralsdund versucht er alles.
Dialogue: 0,0:00:01.96,0:00:03.02,Default,,0,0,0,,Er meiselte Stunden lang
Dialogue: 0,0:00:03.02,0:00:04.04,Default,,0,0,0,,mit dem Taschenmesser am
Dialogue: 0,0:00:04.04,0:00:05.54,Default,,0,0,0,,Fels, millimeter für millimeter.
Dialogue: 0,0:00:06.26,0:00:07.58,Default,,0,0,0,,Nach 15 Stunden war
Dialogue: 0,0:00:07.58,0:00:08.98,Default,,0,0,0,,der Fels kaum angekratzt.
Dialogue: 0,0:00:09.34,0:00:10.12,Default,,0,0,0,,Dann baute er ein
Dialogue: 0,0:00:10.12,0:00:11.38,Default,,0,0,0,,Flaschenzug aus dem Seil,
Dialogue: 0,0:00:11.46,0:00:12.00,Default,,0,0,0,,das er aber sich
Dialogue: 0,0:00:12.00,0:00:13.12,Default,,0,0,0,,hatte. Er zog mit
Dialogue: 0,0:00:13.12,0:00:14.82,Default,,0,0,0,,seiner gesamten Körperkraft gegen
Dialogue: 0,0:00:14.82,0:00:17.54,Default,,0,0,0,,360 kg, mit einer
Dialogue: 0,0:00:17.54,0:00:19.26,Default,,0,0,0,,Hand. Der Stein bewegte
Dialogue: 0,0:00:19.26,0:00:20.80,Default,,0,0,0,,sich kein Millimeter. Mit
Dialogue: 0,0:00:20.80,0:00:22.24,Default,,0,0,0,,jedem Versuch verbrauchte er
Dialogue: 0,0:00:22.24,0:00:23.10,Default,,0,0,0,,Energie, die er nicht
Dialogue: 0,0:00:23.10,0:00:24.52,Default,,0,0,0,,hatte. Er war komplett
Dialogue: 0,0:00:24.52,0:00:26.80,Default,,0,0,0,,allein. In einer Innenfelsslucht,
Dialogue: 0,0:00:27.32,0:00:28.70,Default,,0,0,0,,mit Lebensmitteln für Stunden,
Dialogue: 0,0:00:28.70,0:00:30.78,Default,,0,0,0,,und er begreifen, dass
Dialogue: 0,0:00:30.78,0:00:31.78,Default,,0,0,0,,er hier vielleicht nicht
Dialogue: 0,0:00:31.78,0:00:32.56,Default,,0,0,0,,lebend herausgehen.