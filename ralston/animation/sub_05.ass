Dialogue: 0,0:00:00.00,0:00:01.86,Default,,0,0,0,,Tag drei, Ralsdum konnte
Dialogue: 0,0:00:01.86,0:00:03.52,Default,,0,0,0,,seine Körpertemperaturen nicht mehr
Dialogue: 0,0:00:03.52,0:00:04.96,Default,,0,0,0,,erhalten, die Nächte in
Dialogue: 0,0:00:04.96,0:00:06.40,Default,,0,0,0,,der Schluchzanten unter Nullgrad,
Dialogue: 0,0:00:06.88,0:00:08.46,Default,,0,0,0,,tagsüber direkte Wüsten Sonne,
Dialogue: 0,0:00:08.90,0:00:10.72,Default,,0,0,0,,erschwankte zwischen Schüttelfrost und
Dialogue: 0,0:00:10.72,0:00:12.60,Default,,0,0,0,,Hitzekollabs, die Wasserflasche war
Dialogue: 0,0:00:12.60,0:00:13.86,Default,,0,0,0,,schon lange leer. Er
Dialogue: 0,0:00:13.86,0:00:15.02,Default,,0,0,0,,fing an, seinen eigenen
Dialogue: 0,0:00:15.02,0:00:16.50,Default,,0,0,0,,Orin zu trinken, erst
Dialogue: 0,0:00:16.50,0:00:17.76,Default,,0,0,0,,wieder stand er, dann
Dialogue: 0,0:00:17.76,0:00:18.68,Default,,0,0,0,,hatte er keine Wahlen
Dialogue: 0,0:00:18.68,0:00:20.26,Default,,0,0,0,,mehr. Er sprach ab
Dialogue: 0,0:00:20.26,0:00:21.40,Default,,0,0,0,,Skizworte in die kleine
Dialogue: 0,0:00:21.40,0:00:23.24,Default,,0,0,0,,Videokamera, an seine Eltern,
Dialogue: 0,0:00:23.94,0:00:25.60,Default,,0,0,0,,an seine Schwäste. Dann
Dialogue: 0,0:00:25.60,0:00:26.50,Default,,0,0,0,,nahm er das Messer
Dialogue: 0,0:00:26.50,0:00:27.80,Default,,0,0,0,,und ritzte vier Dinge
Dialogue: 0,0:00:27.80,0:00:28.68,Default,,0,0,0,,in den Fähl über
Dialogue: 0,0:00:28.68,0:00:30.26,Default,,0,0,0,,seine Schulter, seinen Namen,
Dialogue: 0,0:00:30.76,0:00:32.40,Default,,0,0,0,,seinen Geburtstattung und sein
Dialogue: 0,0:00:32.40,0:00:34.48,Default,,0,0,0,,Todestartung, er glaubte, dass
Dialogue: 0,0:00:34.48,0:00:35.24,Default,,0,0,0,,er in Frieden damit
Dialogue: 0,0:00:35.24,0:00:35.48,Default,,0,0,0,,war.